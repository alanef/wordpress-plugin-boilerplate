{
  "phpVersion": "8.4",
  "plugins": [
    "./plugin-name"
  ],
  "port": 8810,
  "testsPort": 8811,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": true,
    "SCRIPT_DEBUG": true
  },
  "mappings": {
    "tests": "./tests",
    "vendor": "./vendor",
    "phpunit.xml.dist": "./phpunit.xml.dist"
  },
  "env": {
    "tests": {
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false
      }
    }
  }
}
